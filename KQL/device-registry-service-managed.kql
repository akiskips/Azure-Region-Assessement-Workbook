resources
| where type in~ ('microsoft.deviceregistry/namespaces', 'microsoft.deviceregistry/assets', 'microsoft.deviceregistry/assetendpointprofiles', 'microsoft.deviceregistry/schemaregistries')
| project id, name, subscriptionId, resourceGroup, location,
    resourceType = tolower(type), service = 'Device Registry',
    evidence = 'Documented service behavior',
    pairedConfigurationDetected = 'Not exposed - service-managed; verify region support',
    pairedRegionConfiguration = 'Microsoft-managed data replication and failover to the paired region',
    observedConfiguration = 'Documented service-managed replication; no customer replication flag or replication health is assessed.',
    nextAction = 'Confirm current region support and paired-region recovery limitations; assess dependent IoT Hub / IoT Operations components separately.'