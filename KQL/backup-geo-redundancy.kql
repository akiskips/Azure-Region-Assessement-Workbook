Resources
| where type in~ ('microsoft.recoveryservices/vaults', 'microsoft.dataprotection/backupvaults')
| where location in~ ({SourceRegions}) or '*' in ({SourceRegions})
    or isempty(location) or location =~ 'global'
| where '*' in ({ResourceGroups}) or resourceGroup in~ ({ResourceGroups})
| extend resourceType = tolower(type),
    recoveryVaultRedundancy = tostring(properties.redundancySettings.standardTierStorageRedundancy),
    recoveryVaultCrr = tostring(properties.redundancySettings.crossRegionRestore),
    backupVaultStorage = tostring(properties.storageSettings),
    backupVaultCrr = tostring(properties.featureSettings.crossRegionRestoreSettings.state)
| extend geoRedundant = case(
    resourceType == 'microsoft.recoveryservices/vaults', recoveryVaultRedundancy =~ 'GeoRedundant',
    backupVaultStorage contains '"GeoRedundant"'),
    crossRegionRestore = iff(resourceType == 'microsoft.recoveryservices/vaults', recoveryVaultCrr, backupVaultCrr)
| where geoRedundant or crossRegionRestore =~ 'Enabled'
| extend pairedRegionConfiguration = case(
    geoRedundant and crossRegionRestore =~ 'Enabled', 'Geo-redundant backup storage + Cross Region Restore (CRR)',
    geoRedundant, 'Geo-redundant backup storage',
    'Cross Region Restore (CRR)')
| project id, name, subscriptionId, resourceGroup, location, resourceType,
    service = 'Backup', evidence = 'Detected configuration', pairedRegionConfiguration,
    recoveryVaultRedundancy, backupVaultStorage, crossRegionRestore,
    replicatedRegions = tostring(properties.replicatedRegions)