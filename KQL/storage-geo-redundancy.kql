Resources
| where type =~ 'microsoft.storage/storageaccounts'
| where location in~ ({SourceRegions}) or '*' in ({SourceRegions})
    or isempty(location) or location =~ 'global'
| where '*' in ({ResourceGroups}) or resourceGroup in~ ({ResourceGroups})
| extend storageSku = tostring(sku.name)
| where storageSku in~ ('Standard_GRS', 'Standard_RAGRS', 'Standard_GZRS', 'Standard_RAGZRS')
| extend pairedRegionConfiguration = case(
    storageSku =~ 'Standard_GRS', 'GRS',
    storageSku =~ 'Standard_RAGRS', 'RA-GRS',
    storageSku =~ 'Standard_GZRS', 'GZRS',
    'RA-GZRS')
| project id, name, subscriptionId, resourceGroup, location,
    service = 'Storage', evidence = 'Detected configuration', pairedRegionConfiguration,
    storageSku, primaryLocation = tostring(properties.primaryLocation),
    secondaryLocation = tostring(properties.secondaryLocation),
    secondaryStatus = tostring(properties.statusOfSecondary)