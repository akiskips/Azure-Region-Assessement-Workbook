resources
| where type =~ 'microsoft.storageactions/storagetasks'
| project id, name, subscriptionId, resourceGroup, location,
    resourceType = tolower(type), service = 'Storage Actions',
    evidence = 'Needs verification',
    pairedConfigurationDetected = 'Not assessed - verify dependencies / service settings',
    pairedRegionConfiguration = 'Task continuity follows target storage account geo-redundancy (not assessed)',
    observedConfiguration = 'Storage task inventory only. Assignments and target storage account redundancy REQUIRE service API verification.',
    nextAction = 'Enumerate task assignments and inspect each target storage account for GRS/GZRS. Verify task completion after storage failover and retry interrupted operations.'