Resources
| where type in~ ('microsoft.dbforpostgresql/flexibleservers', 'microsoft.dbformysql/flexibleservers')
| where location in~ ({SourceRegions}) or '*' in ({SourceRegions})
    or isempty(location) or location =~ 'global'
| where '*' in ({ResourceGroups}) or resourceGroup in~ ({ResourceGroups})
| extend flexibleGeoBackup = tostring(properties.backup.geoRedundantBackup)
| where flexibleGeoBackup =~ 'Enabled'
| project id, name, subscriptionId, resourceGroup, location, resourceType = tolower(type),
    service = 'PostgreSQL / MySQL', evidence = 'Detected configuration',
    pairedRegionConfiguration = 'Geo-redundant backups', flexibleGeoBackup,
    replicaRole = tostring(properties.replicationRole),
    sourceServer = tostring(properties.sourceServerResourceId)